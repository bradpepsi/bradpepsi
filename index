<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Brad Pepsi</title>
<style>
  /* Alte Haas Grotesk: put the font files in a "fonts" folder next to this page.
     Until they're there, it falls back to Helvetica / Arial. */
  @font-face {
    font-family: "Alte Haas Grotesk";
    src: local("Alte Haas Grotesk"), local("AlteHaasGrotesk"),
         url("fonts/AlteHaasGrotesk.ttf") format("truetype");
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: "Alte Haas Grotesk";
    src: local("Alte Haas Grotesk Bold"), local("AlteHaasGrotesk-Bold"),
         url("fonts/AlteHaasGrotesk_Bold.ttf") format("truetype");
    font-weight: 700;
    font-display: swap;
  }

  :root {
    --ink: #000;
    --muted: #555;
    --column: 720px;
    --font: "Alte Haas Grotesk", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: #fff;
    color: var(--ink);
    font-family: var(--font);
    -webkit-text-size-adjust: 100%;
  }

  /* One centered column; the title and the sections share its left edge */
  .wrap {
    max-width: var(--column);
    margin: 0 auto;
    padding: 28px 20px 80px;
  }
  @media (min-width: 900px) { .wrap { padding-top: 64px; } }

  /* ---- Animated title ---- */
  #title { display: block; width: 100%; height: auto; }
  /* Ink dots start hidden and pop in instantly: no fade, no scaling */
  #title circle.ink { opacity: 0; }
  #title circle.ink.on { opacity: 1; }

  /* ---- Dropdown sections ---- */
  .sections { margin-top: 28px; }

  .toggle {
    display: flex;
    align-items: baseline;
    gap: 0.45em;
    width: 100%;
    margin: 0;
    padding: 9px 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 1.4rem;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }
  .toggle:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  /* The little symbols. Change the characters in the content: lines to swap them.
     Top-level sections use + and minus. */
  .chev { font-size: 0.9em; color: var(--muted); }
  .toggle[aria-expanded="false"] .chev::before { content: "+"; }
  .toggle[aria-expanded="true"]  .chev::before { content: "\2212"; }

  /* faq questions use > and < instead */
  .toggle.sub .chev { font-size: 0.7em; }
  .toggle.sub[aria-expanded="false"] .chev::before { content: ">"; }
  .toggle.sub[aria-expanded="true"]  .chev::before { content: "<"; }

  .panel { padding: 2px 0 14px; max-width: 34em; }
  .panel[hidden] { display: none; }
  .panel p { margin: 0 0 0.8em; font-size: 0.95rem; line-height: 1.4; }
  .panel p:last-child { margin-bottom: 0; }
  .panel a { color: inherit; font-weight: 700; text-underline-offset: 0.15em; }

  /* faq: each question is its own dropdown, with the answer slightly indented */
  .toggle.sub {
    font-size: 1rem;
    font-weight: 700;
    padding: 7px 0;
  }
  .answer { padding: 0 0 8px 1.25rem; }
  #p-faq { padding-top: 0; }
</style>
</head>
<body>

<div class="wrap">

  <header>
    <svg id="title" role="img" aria-label="Brad Pepsi" viewBox="34 0 5412 1045"></svg>
  </header>

  <main class="sections">

    <section>
      <button class="toggle" id="t-info" aria-expanded="false" aria-controls="p-info">
        <span>info</span><span class="chev" aria-hidden="true"></span>
      </button>
      <div class="panel" id="p-info" role="region" aria-labelledby="t-info" hidden>
        <p>handpoke tattoo tattoo tattoo tattoo tattoo tattoo tattoo</p>
      </div>
    </section>

    <section>
      <button class="toggle" id="t-book" aria-expanded="false" aria-controls="p-book">
        <span>book</span><span class="chev" aria-hidden="true"></span>
      </button>
      <div class="panel" id="p-book" role="region" aria-labelledby="t-book" hidden>
        <p>please email <a href="mailto:hellobradpepsi@gmail.com">hellobradpepsi@gmail.com</a> with your name and an attached image or description of the flash or design you'd like, along with a rough estimate on size and desired placement.</p>
        <p>if you have a specific budget, please include it here and i'll be more than happy to work within it!</p>
        <p>if you have any other contact information of mine already, feel free to reach out elsewhere for tattoos.</p>
      </div>
    </section>

    <section>
      <button class="toggle" id="t-faq" aria-expanded="false" aria-controls="p-faq">
        <span>faq</span><span class="chev" aria-hidden="true"></span>
      </button>
      <div class="panel" id="p-faq" role="region" aria-labelledby="t-faq" hidden>
        <div class="qa">
          <button class="toggle sub" id="t-q1" aria-expanded="false" aria-controls="p-q1">
            <span>aftercare?</span><span class="chev" aria-hidden="true"></span>
          </button>
          <div class="panel answer" id="p-q1" role="region" aria-labelledby="t-q1" hidden>
            <!-- TODO: add aftercare answer -->
            <p>aftercare info coming soon.</p>
          </div>
        </div>
        <div class="qa">
          <button class="toggle sub" id="t-q2" aria-expanded="false" aria-controls="p-q2">
            <span>will you draw me a custom tattoo?</span><span class="chev" aria-hidden="true"></span>
          </button>
          <div class="panel answer" id="p-q2" role="region" aria-labelledby="t-q2" hidden>
            <p>yes! you can ask for any custom. there are some ideas that are beautiful but outside of my skillset/comfort zone. in these cases, i might try to refer you to another tattooer (animals, cybersigilism, large-scale, low-detail blackwork)</p>
          </div>
        </div>
        <div class="qa">
          <button class="toggle sub" id="t-q3" aria-expanded="false" aria-controls="p-q3">
            <span>do i have to be 18+?</span><span class="chev" aria-hidden="true"></span>
          </button>
          <div class="panel answer" id="p-q3" role="region" aria-labelledby="t-q3" hidden>
            <p>yes! i will not tattoo you if you are under the age of 18!!! even if you bring your parents!!!</p>
          </div>
        </div>
        <div class="qa">
          <button class="toggle sub" id="t-q4" aria-expanded="false" aria-controls="p-q4">
            <span>what does it feel like...</span><span class="chev" aria-hidden="true"></span>
          </button>
          <div class="panel answer" id="p-q4" role="region" aria-labelledby="t-q4" hidden>
            <p>handpoke tattoos are generally less painful than "traditional" machine tattooing (in my personal experience!) it still feels like a tattoo, but if you have bad memories from your 10-year-old india ink sewing needle stick n poke, it's not like that...</p>
          </div>
        </div>
      </div>
    </section>

  </main>
</div>

<script>
/* Dot positions are taken from the glyph outlines of "G.B. Jones Lite"
   by Nat Pyper (SIL Open Font License 1.1), laid out as "Brad Pepsi".
   Coordinates are in font units (1000 per em), y pointing up. */

// ---- Settings you can tweak -------------------------------------------
const COLOR     = "#000";       // the "ink" dots
const STENCIL_COLOR   = "#7b4fd6";  // faint stencil guide
const STENCIL_OPACITY = 0.25;
const JITTER    = 14;      // how far ink can land off the stencil (font units;
                           // dot radius is 54, so 14 = "almost exactly on top")
const DOT_R     = 54;     // dot radius in font units (the font's own size)

// Order: "letters" = one letter at a time, dots in random order within it
//        "random"  = every dot in the whole title in random order
const ORDER     = "letters";

// Timing, in milliseconds between dots
const MIN_DELAY = 25;      // fastest gap
const MAX_DELAY = 140;     // slowest normal gap
const PAUSE_CHANCE = 0.06; // chance of a brief "hesitation" after a dot
const PAUSE_MS  = [200, 450]; // range of that hesitation
const LETTER_PAUSE = [120, 300]; // extra pause between letters ("letters" mode)
// -----------------------------------------------------------------------

// One array per letter: [x, y] for every dot
const LETTERS = [
  [[128,696],[253,696],[378,696],[440,589],[128,482],[502,482],[190,376],[315,376],[440,376],[128,268],[502,268],[564,161],[128,54],[253,54],[378,54],[502,54]],
  [[796,482],[921,482],[1046,482],[1108,376],[796,268],[796,54]],
  [[1378,482],[1502,482],[1564,376],[1378,268],[1502,268],[1627,268],[1316,161],[1690,161],[1378,54],[1502,54],[1752,54]],
  [[2308,696],[2308,482],[2183,482],[2058,482],[1996,376],[2308,268],[1934,268],[1996,161],[2308,54],[2183,54],[2058,54]],
  [[3064,696],[3189,696],[3314,696],[3376,589],[3064,482],[3438,482],[3126,376],[3252,376],[3376,376],[3064,268],[3064,54]],
  [[3733,482],[3858,482],[3670,376],[3920,376],[3733,268],[3858,268],[3670,161],[3733,54],[3858,54],[3982,54]],
  [[4214,482],[4339,482],[4464,482],[4526,376],[4214,268],[4588,268],[4526,161],[4214,54],[4339,54],[4464,54],[4214,-161]],
  [[4896,482],[5020,482],[4834,376],[4771,268],[4896,268],[5020,268],[5144,268],[5082,161],[4896,54],[5020,54]],
  [[5352,696],[5352,268],[5352,54]]
];

const TOP = 790; // flips font y (up) into SVG y (down)

const rand  = (a, b) => a + Math.random() * (b - a);
const shuffle = arr => {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
};

const svg = document.getElementById("title");
const NS = "http://www.w3.org/2000/svg";

// Stencil layer first, so the ink always sits on top of it
const stencil = document.createElementNS(NS, "g");
stencil.setAttribute("fill", STENCIL_COLOR);
stencil.setAttribute("opacity", STENCIL_OPACITY);
svg.appendChild(stencil);
LETTERS.flat().forEach(([x, y]) => {
  const g = document.createElementNS(NS, "circle");
  g.setAttribute("cx", x);
  g.setAttribute("cy", TOP - y);
  g.setAttribute("r", DOT_R);
  stencil.appendChild(g);
});

// Ink dot: lands a hair off the stencil, a slightly different amount each load
function makeDot([x, y]) {
  const c = document.createElementNS(NS, "circle");
  c.setAttribute("class", "ink");
  c.setAttribute("cx", (x + rand(-JITTER, JITTER)).toFixed(1));
  c.setAttribute("cy", (TOP - y + rand(-JITTER, JITTER)).toFixed(1));
  c.setAttribute("r", (DOT_R + rand(-2, 2)).toFixed(1));
  c.setAttribute("fill", COLOR);
  svg.appendChild(c);
  return c;
}

// Build the reveal queue: each item is { el, endOfLetter }
let queue = [];
if (ORDER === "random") {
  const all = LETTERS.flat().map(d => ({ el: makeDot(d), endOfLetter: false }));
  queue = shuffle(all);
} else {
  LETTERS.forEach(group => {
    const items = group.map(d => ({ el: makeDot(d), endOfLetter: false }));
    shuffle(items);
    items[items.length - 1].endOfLetter = true;
    queue.push(...items);
  });
}

// Reveal one dot at a time with human-ish, uneven timing
const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
function next(i) {
  if (i >= queue.length) return;
  const item = queue[i];
  item.el.classList.add("on");

  // Skewed toward quick gaps, with occasional slower ones
  let wait = MIN_DELAY + Math.pow(Math.random(), 2) * (MAX_DELAY - MIN_DELAY);
  if (Math.random() < PAUSE_CHANCE) wait += rand(...PAUSE_MS);
  if (item.endOfLetter) wait += rand(...LETTER_PAUSE);

  setTimeout(() => next(i + 1), wait);
}

if (reduceMotion) {
  queue.forEach(q => q.el.classList.add("on"));
} else {
  setTimeout(() => next(0), 400); // short beat before starting
}

/* ---- Dropdown sections: click to open, click again to snap shut ---- */
document.querySelectorAll(".toggle").forEach(btn => {
  btn.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    document.getElementById(btn.getAttribute("aria-controls")).hidden = open;
  });
});
</script>
</body>
</html>
